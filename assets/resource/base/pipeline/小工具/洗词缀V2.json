{
    // 圣痕洗词缀 V2：从能同时看到旧、新词缀的重构结果页启动。
    // ROI 使用 1280x720 基准分辨率。主页词缀可能截断或被锁图标遮挡，只用于确认页面。
    // 词缀锁模式需要先手动锁好一条；自定义动作核对两侧完整词缀，无法确认时停止。
    // 按钮通过原生 OCR + Click 识别并点击文字框，轮询与动画等待由 pipeline 管理。

    "洗词缀V2": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": "Custom",
        "custom_action": "AffixRerollV2",
        // attach 按字段合并，界面各选项只覆盖自己的键。
        "attach": {
            "模式": "直接洗词缀",
            "确认词缀锁": "No",
            "单条高攻": "Yes",
            "单条达标值": 22.9,
            "属性": "异能",
            "武器": "弓箭、环刃",
            "目标攻击力": 42.0,
            "最大重构次数": 500,
            "OCR重试次数": 3,
            "nodes": {
                "old": ["洗词缀V2-识别-旧词缀1", "洗词缀V2-识别-旧词缀2"],
                "new": ["洗词缀V2-识别-新词缀1", "洗词缀V2-识别-新词缀2"],
                "result_markers": [
                    ["洗词缀V2-点击-保留旧词缀", "「保留旧词缀」按钮"],
                    ["洗词缀V2-点击-写入新词缀", "「写入新词缀」按钮"]
                ],
                "homes": {
                    "直接洗词缀": {
                        "label": "普通重构页",
                        "markers": [
                            ["洗词缀V2-普通-验证-培养预览", "右侧「重新生成2个词缀技能…」说明"],
                            ["洗词缀V2-普通-验证-十次重构按钮", "右下「十次重构」按钮"],
                            ["洗词缀V2-主页-验证-词缀技能面板", "左下「词缀技能」面板"]
                        ],
                        "roll": "洗词缀V2-普通-点击-词缀重构",
                        "fast_reroll": "洗词缀V2-点击-再次重构"
                    },
                    "词缀锁洗词缀": {
                        "label": "定向重构页",
                        "markers": [
                            ["洗词缀V2-锁-验证-定向重构页签", "顶部「定向重构」页签"],
                            ["洗词缀V2-锁-验证-培养预览", "右侧「锁定的词缀…」说明"],
                            ["洗词缀V2-主页-验证-词缀技能面板", "左下「词缀技能」面板"]
                        ],
                        "roll": "洗词缀V2-锁-点击-词缀重构",
                        "fast_reroll": null
                    }
                }
            }
        },
        "focus": {
            "Node.Action.Starting": "开始智能洗词缀：按有效攻击力在新旧词缀之间择优",
            "Node.Action.Succeeded": "智能洗词缀完成",
            "Node.Action.Failed": "智能洗词缀未达成目标，已停止"
        }
    },

    // ======================================================================
    // 一、结果页（两种模式共用）
    //     右上角两个大面板，按钮在下方
    // ======================================================================
    "洗词缀V2-识别-旧词缀1": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [640, 168, 615, 84],
                "expected": []
            }
        }
    },
    "洗词缀V2-识别-旧词缀2": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [640, 262, 615, 82],
                "expected": []
            }
        }
    },
    "洗词缀V2-识别-新词缀1": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [640, 448, 615, 76],
                "expected": []
            }
        }
    },
    "洗词缀V2-识别-新词缀2": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [640, 536, 615, 78],
                "expected": []
            }
        }
    },
    // 再次重构：只在【普通重构的结果页】上有（词缀锁的结果页没有这个按钮）。
    // 点它可以在结果页原地换一批新词缀，不用回主页，快得多。
    "洗词缀V2-点击-再次重构": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [190, 606, 238, 114],
                "expected": ["再次\\s*重\\s*构"]
            }
        },
        "action": "Click",
        "timeout": 2000,
        "rate_limit": 200,
        "post_delay": 2000
    },
    // 保留 / 写入：OCR 命中后，由框架点击识别框
    //   实测文字框：「保留旧词缀」x 719..864，「写入新词缀」x 1035..1180，y 646..685
    "洗词缀V2-点击-保留旧词缀": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [700, 630, 210, 72],
                "expected": ["保留\\s*旧\\s*词\\s*缀"]
            }
        },
        "action": "Click",
        "timeout": 2000,
        "rate_limit": 200,
        "post_delay": 2000
    },
    "洗词缀V2-点击-写入新词缀": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [1016, 630, 210, 72],
                "expected": ["写入\\s*新\\s*词\\s*缀"]
            }
        },
        "action": "Click",
        "timeout": 2000,
        "rate_limit": 200,
        "post_delay": 2000
    },

    // ======================================================================
    // 二、主页标记 + 重投按钮
    //     任务本身从【重构结果页】启动；只有「保留/写入」之后游戏会强制回到主页，
    //     这时用这些标记确认人确实回到了主页，再点「词缀重构」回结果页。
    //     （主页左下那块「词缀技能」面板显示不全 —— 词缀名一长就被面板自己截掉，
    //       定向重构页上锁定的那条还会被游戏自己的「已锁定」标记盖住；
    //       所以任务**不读**它，只拿它当“人在主页”的标记）
    // ======================================================================
    "洗词缀V2-主页-验证-词缀技能面板": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [45, 470, 200, 40],
                "expected": ["词缀技能"]
            }
        }
    },

    // ======================================================================
    // 三、普通重构页（模式：直接洗词缀）
    //     主页说明文字是「重新生成2个词缀技能…」（注意：这和词缀锁页的不一样）
    //     右下角有两个按钮：词缀重构 / 十次重构
    // ======================================================================
    "洗词缀V2-普通-验证-培养预览": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [700, 360, 495, 110],
                "expected": ["重新生成.个词缀技能"]
            }
        }
    },
    "洗词缀V2-普通-验证-十次重构按钮": {
        // 「十次重构」只有普通重构页才有，用来确认没跑错页
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [1015, 630, 180, 50],
                "expected": ["十次\\s*重\\s*构"]
            }
        }
    },
    "洗词缀V2-普通-点击-词缀重构": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [720, 630, 190, 50],
                "expected": ["词缀\\s*重\\s*构"]
            }
        },
        "action": "Click",
        "timeout": 2000,
        "rate_limit": 200,
        "post_delay": 2000
    },

    // ======================================================================
    // 四、定向重构页（模式：词缀锁洗词缀）
    //     说明文字是「锁定的词缀不会被重构…」，右下角只有一个「词缀重构」
    // ======================================================================
    "洗词缀V2-锁-验证-定向重构页签": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [1045, 98, 130, 40],
                "expected": ["定向\\s*重\\s*构"]
            }
        }
    },
    "洗词缀V2-锁-验证-培养预览": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [695, 385, 350, 80],
                "expected": ["锁定的词缀"]
            }
        }
    },
    // 自定义动作核对两侧未变化的完整词缀；条件不同或无法确认时停止。
    "洗词缀V2-锁-点击-词缀重构": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [870, 628, 190, 58],
                "expected": ["词缀\\s*重\\s*构"]
            }
        },
        "action": "Click",
        "timeout": 2000,
        "rate_limit": 200,
        "post_delay": 2000
    }
}
